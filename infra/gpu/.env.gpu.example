# HIPPO-AI GPU node
# Copy to .env.gpu and keep it private.

# LLM
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
VLLM_SERVED_MODEL=hippo-ai
VLLM_PORT=8001
VLLM_API_KEY=change-me
VLLM_GPU_MEMORY_UTILIZATION=0.78
VLLM_MAX_MODEL_LEN=32768

# Speech-to-text
WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cuda
WHISPER_MODEL=Systran/faster-whisper-large-v3
WHISPER_PORT=8002
WHISPER_API_KEY=change-me

# Persistent data. The host should have a large data disk mounted here.
HIPPO_GPU_DATA_DIR=/data/hippo-ai
