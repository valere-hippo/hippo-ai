{
  "name": "hippo-ai-desktop",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --windows",
    "build:mac-icon": "bash scripts/make-macos-icon.sh",
    "package:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.8.0"
  },
  "build": {
    "appId": "com.hippoai.desktop",
    "productName": "HIPPO-AI",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
