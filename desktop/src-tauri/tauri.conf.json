{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tier AI",
  "version": "0.1.0",
  "identifier": "com.valere.tierai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Tier AI",
        "width": 1280,
        "height": 920,
        "resizable": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "targets": "nsis"
  }
}
