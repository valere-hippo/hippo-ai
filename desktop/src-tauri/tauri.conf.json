{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hippo-ai",
  "version": "0.1.0",
  "identifier": "com.valere.hippoai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "hippo-ai",
        "width": 1280,
        "height": 920,
        "resizable": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "nsis"
  }
}
